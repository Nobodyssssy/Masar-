{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Masar",
  "version": "0.1.0",
  "identifier": "ch.local.jobup.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run prepare:runtime",
    "beforeBuildCommand": "npm run prepare:runtime"
  },
  "app": {
    "windows": [
      {
        "title": "Masar (مسار) — Recherche & Candidatures",
        "width": 1300,
        "height": 850,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "runtime/": "runtime/",
      "../licenses/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
